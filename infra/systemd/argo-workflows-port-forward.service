[Unit]
Description=Local-only Argo Workflows dashboard port forward
After=k3s.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml port-forward -n argo svc/argo-server 2746:2746 --address=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
